#!/bin/sh
# Updates self-hosted Docker Compose apps on a NAS with one command.
#
#   selfhostit update splitwiz        pull the newest image and recreate if needed
#   selfhostit update splitwiz flowy  several apps in one go
#   selfhostit update all             every app folder that has a compose file
#   selfhostit list                   apps found and the image each one runs
#
# Each app is a folder under /volume1/docker (Synology's usual place) holding
# a docker-compose.yml. Set SELFHOSTIT_DIR to use another parent folder.
# Asks for your password once, for sudo.
set -e

ROOT=${SELFHOSTIT_DIR:-/volume1/docker}

# sudo on DSM doesn't search /usr/local/bin, so call docker by its full path
DOCKER=$(command -v docker 2>/dev/null || true)
[ -n "$DOCKER" ] || DOCKER=/usr/local/bin/docker
if [ "$(id -u)" -eq 0 ]; then SUDO=; else SUDO=sudo; fi

usage() {
  sed -n '3,7s/^# \{0,1\}//p' "$0"
  exit "${1:-0}"
}

compose_file() {
  for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
    [ -f "$1/$f" ] && { echo "$1/$f"; return 0; }
  done
  return 1
}

apps() {
  for d in "$ROOT"/*/; do
    d=${d%/}
    compose_file "$d" >/dev/null && basename "$d"
  done
}

dc() { $SUDO "$DOCKER" compose "$@"; }

# one line per container: "<name> <container id> <image id>"
snapshot() {
  for id in $(dc ps -q 2>/dev/null); do
    $SUDO "$DOCKER" inspect -f '{{.Name}} {{.Id}} {{.Image}}' "$id"
  done | sed 's|^/||' | sort
}

update_one() {
  app=$1
  dir=$ROOT/$app
  if ! compose_file "$dir" >/dev/null; then
    echo "selfhostit: no compose file in $dir" >&2
    echo "Apps found: $(apps | tr '\n' ' ')" >&2
    return 1
  fi
  cd "$dir" || return 1
  echo "== $app ($dir)"
  echo "Images:"
  dc config --images 2>/dev/null | sed 's/^/  /'

  before=$(snapshot)
  # set -e is off inside "||", so check each step
  dc pull -q || return 1
  dc up -d --remove-orphans || return 1
  after=$(snapshot)

  echo "Result:"
  echo "$after" | while read -r name cid img; do
    [ -n "$name" ] || continue
    old=$(echo "$before" | awk -v n="$name" '$1 == n')
    old_cid=$(echo "$old" | awk '{print $2}')
    old_img=$(echo "$old" | awk '{print $3}')
    if [ -z "$old" ]; then
      echo "  $name: started (was not running)"
    elif [ "$old_cid" = "$cid" ]; then
      echo "  $name: already up to date"
    elif [ "$old_img" != "$img" ]; then
      echo "  $name: recreated with a new image"
    else
      echo "  $name: recreated (settings changed)"
    fi
  done
  echo
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  update|up)
    [ $# -gt 0 ] || { echo "usage: selfhostit update <app>... | all" >&2; exit 2; }
    [ "$1" = all ] && set -- $(apps)
    $SUDO true  # ask for the password once, up front
    failed=
    for app in "$@"; do
      ( update_one "$app" ) || failed="$failed $app"
    done
    if [ -n "$failed" ]; then
      echo "Failed:$failed" >&2
      exit 1
    fi
    ;;
  list|ls)
    for app in $(apps); do
      imgs=$(cd "$ROOT/$app" && dc config --images 2>/dev/null | tr '\n' ' ')
      printf '%-16s %s\n' "$app" "$imgs"
    done
    ;;
  ''|-h|--help|help) usage ;;
  *) echo "selfhostit: unknown command '$cmd'" >&2; usage 2 >&2 ;;
esac
