# Copy to .env next to docker-compose.yml and change what you need.
# Every line is optional; the value shown is the default.

# Your time zone (a name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
# Decides when repeating expenses are added and when the nightly backup runs.
TZ=UTC

# Who can connect:
#   127.0.0.1  only this machine, and a reverse proxy running on it (safest)
#   0.0.0.0    every device on your network, at http://<this-machine>:<port>.
#              On a VPS that is the whole internet: Docker opens the port even
#              when a firewall such as ufw blocks it.
SPLITWIZ_LISTEN=127.0.0.1

# Port on this machine. The installer picks the next free one if 8090 is taken.
SPLITWIZ_PORT=8090

# Where the database, backups and push key are kept. Back this folder up.
SPLITWIZ_DATA=./pb_data

# Image tag. "latest" follows main; a commit SHA pins one exact build.
SPLITWIZ_VERSION=latest

# Optional mailto: or https: address that push services can contact about
# notifications sent from this server.
SPLITWIZ_PUSH_CONTACT=
